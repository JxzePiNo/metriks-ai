# Copy to .env and fill in real values. Never commit .env.
# Placeholders only: this file must not contain real secrets.

# --- General ---
APP_ENV=local

# --- Backend (FastAPI) ---
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS: browser origin(s) allowed to call the API (comma-separated, no wildcard)
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (Docker Compose) ---
# Local development defaults only. NOT production credentials.
POSTGRES_USER=metriks
POSTGRES_PASSWORD=metriks_dev_password
POSTGRES_DB=metriks
POSTGRES_PORT=5432

# --- Application database connection (introduced in a later PR) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/dms

# --- AWS (introduced in later PRs; prefer SSO/roles over static keys) ---
# AWS_REGION=eu-south-1

# --- OpenAI (introduced in a later PR; production uses Secrets Manager) ---
# OPENAI_API_KEY=
