# Copy to .env and fill in real values. Never commit .env.
# Placeholders only: this file must not contain real secrets.

# --- General ---
APP_ENV=local

# --- Backend (FastAPI) ---
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS: browser origin(s) allowed to call the API (comma-separated, no wildcard)
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (Docker Compose) ---
# Local development defaults only. NOT production credentials.
POSTGRES_USER=metriks
POSTGRES_PASSWORD=metriks_dev_password
POSTGRES_DB=metriks
POSTGRES_PORT=5432

# --- Application database connection (introduced in a later PR) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/dms

# --- AWS (introduced in later PRs; prefer SSO/roles over static keys) ---
# AWS_REGION=eu-south-1

# --- Privacy-first RAG backend (optional; see backend/README.md) ---
RAG_ENABLED=false
RAG_DATA_DIR=./data/rag
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=metriks-chunks-multilingual-v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Fallback only for language-neutral queries such as "API?"; en or it.
DEFAULT_QUERY_LANGUAGE=en
OCR_ENABLED=true
OCR_LANGUAGE=eng+ita
MAX_PDF_BYTES=26214400
MAX_PDF_PAGES=300
SESSION_TTL_SECONDS=86400
# Generate Fernet key and a separate random lookup key; keep both stable.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
# Map randomly generated bearer tokens to SERVER-CONTROLLED identities.
# Replace the placeholder token with a long random secret before enabling RAG.
# Single quotes preserve JSON in dotenv files.
RAG_API_TOKENS='{"replace-with-random-bearer-token":{"tenant_id":"customer-1","user_id":"alice","scopes":["documents:read","documents:write","chat:write","identity:write","pii:read"]}}'
