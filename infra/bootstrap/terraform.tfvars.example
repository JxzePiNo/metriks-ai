# Copy to terraform.tfvars (git-ignored) and adjust. Placeholders only:
# never put credentials or secrets in tfvars files.

# Required: the AWS account Terraform is allowed to operate on (12 digits).
allowed_account_ids = ["123456789012"]

# Required: makes the bucket name globally unique -> <project>-tfstate-<suffix>.
# 6-16 lowercase letters/digits. Choose it yourself, for example the output of:
#   openssl rand -hex 4
# If the resulting name is already taken, `apply` fails; pick another suffix.
bucket_name_suffix = "replace01"

# Optional overrides (defaults shown).
# aws_region                        = "eu-south-1"
# project                           = "metriks-ai"
# environment                       = "shared"
# noncurrent_version_retention_days = 90
# noncurrent_versions_to_keep       = 10
# extra_tags                        = { Owner = "your-team" }
